# Server Configuration
PORT=5001
NODE_ENV=development

# Client URL (for CORS and invite links)
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Database Connection (MySQL)
DATABASE_URL=mysql://root:password@localhost:3306/wedding_rsvp
DATABASE_TEST_URL=mysql://root:password@localhost:3306/wedding_rsvp_test

# Reverse Proxy / Deployment Trust Proxy Setting
# Options: false (default for local dev), 1 (e.g. Render/Railway single hop), loopback, or specific CIDRs
TRUST_PROXY=false

# Session Authentication
SESSION_SECRET=super_secret_session_key_minimum_32_characters_long_for_security

